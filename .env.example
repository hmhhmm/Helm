# Copy to .env. Secrets live here only; .env is git-ignored.
# Local default is a one-file SQLite database. For Postgres use the second line (docker compose sets it for you).
DATABASE_URL=sqlite:///./helm.db
# DATABASE_URL=postgresql+psycopg://helm:helm@localhost:5432/helm

# fixtures = deterministic, no LLM needed (default). live = Reader/Explainer may call a model (needs `pip install -e '.[llm]'` and ANTHROPIC_API_KEY).
LLM_MODE=fixtures
LLM_MODEL=claude-haiku-5-5
# ANTHROPIC_API_KEY=

BANK_SIGNING_SECRET=change-me-in-env
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public demo: resets the database every DEMO_RESET_MINUTES.
DEMO_MODE=false
DEMO_RESET_MINUTES=20

# Owner login. The default passcode is for the public synthetic demo only. Set your own anywhere else.
# OWNER_PASSCODE=change-me
# OWNER_TOKEN_SECRET=change-me-too

# On-chain audit anchor (optional, test network only). Create a NEW throwaway wallet, fund it from a faucet, then run
# `python scripts/deploy_anchor.py` and paste the printed contract address here. Never use a key that holds real value.
# ANCHOR_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# ANCHOR_PRIVATE_KEY=0x...
# ANCHOR_CONTRACT=0x...
# ANCHOR_EXPLORER_TX=https://sepolia.etherscan.io/tx/
